{
  "manifest_version": 3,
  "name": "Yandex Music Sync Lobby",
  "version": "0.1.3",
  "description": "Sync listening lobby for Yandex Music web player.",
  "icons": {
    "16": "icons/icon_16x16.png",
    "32": "icons/icon_32x32.png",
    "48": "icons/icon_48x48.png"
  },
  "action": { "default_icon": "icons/icon_48x48.png"},
  "content_scripts": [
    {
      "matches": ["https://music.yandex.ru/*", "https://music.yandex.com/*"],
      "js": [
        "content/state.js",
        "content/roomUi.js",
        "content/clientApi.js",
        "content/playerSyncBroadcastBridge.js",
        "content/playerSyncHostUi.js",
        "content/bootstrap.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://127.0.0.1:10001/*",
    "http://localhost:10001/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/player-native-bridge.js"],
      "matches": ["https://music.yandex.ru/*", "https://music.yandex.com/*"]
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  }
}
